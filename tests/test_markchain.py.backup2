"""Tests for the MarkChain module."""

import os
import pytest
import tempfile
from pathlib import Path
import re
import numpy as np
from collections import defaultdict, Counter
from mdp.markchain import (
    MarkChain, 
    linear_decay, 
    exponential_decay, 
    gaussian_decay, 
    constant_decay,
    PositionalEncoder
)

# Use the default parser from the MarkChain class as a function
def default_state_parser(markdown_text):
    """Wrapper for the MarkChain's default state parser."""
    chain = MarkChain()
    return chain._default_state_parser(markdown_text)

SAMPLE_MARKDOWN = """# Test Document

This is a paragraph with some text.

## Section 1

- List item 1
- List item 2

```python
def test():
    return True
```

## Section 2

Another paragraph.
"""

def test_decay_functions():
    """Test that all decay functions work correctly."""
    # Test linear decay
    assert linear_decay(1) == 1.0
    assert linear_decay(2) == 0.5
    assert linear_decay(4) == 0.25
    
    # Test exponential decay
    assert exponential_decay(1) == 1.0
    assert exponential_decay(2) == 0.5
    assert exponential_decay(3) == 0.25
    
    # Test with custom base
    assert exponential_decay(2, base=0.25) == 0.25
    assert exponential_decay(3, base=0.25) == 0.0625
    
    # Test Gaussian decay
    assert gaussian_decay(1) == 1.0
    assert 0.6 < gaussian_decay(2) < 0.7  # approx 0.607
    
    # Test with custom sigma
    assert gaussian_decay(2, sigma=2.0) > 0.8
    
    # Test constant decay
    assert constant_decay(1) == 1.0
    assert constant_decay(100) == 1.0

def test_positional_encoder():
    """Test that the positional encoder works correctly."""
    # Create an encoder with small dimensions for testing
    encoder = PositionalEncoder(max_length=10, encoding_dim=4)
    
    # Test encoding at specific positions
    enc0 = encoder.encode(0)
    enc5 = encoder.encode(5)
    enc9 = encoder.encode(9)
    
    # Check encoding dimensions
    assert len(enc0) == 4
    assert len(enc5) == 4
    assert len(enc9) == 4
    
    # Check that encodings are different at different positions
    assert enc0 != enc5
    assert enc5 != enc9
    assert enc0 != enc9
    
    # Test normalized encodings
    norm_enc_start = encoder.encode_normalized(0, 100)
    norm_enc_middle = encoder.encode_normalized(50, 100)
    norm_enc_end = encoder.encode_normalized(99, 100)
    
    # Normalized encodings should map to the full range
    assert norm_enc_start == encoder.encode(0)
    assert norm_enc_middle == encoder.encode(4)  # approx middle
    assert norm_enc_end == encoder.encode(9)  # end
    
    # Test with small document
    small_doc_enc = encoder.encode_normalized(0, 1)
    assert small_doc_enc == encoder.encode(0)

def test_markchain_with_positional_encoding():
    """Test MarkChain with positional encoding enabled."""
    # Create structured document with position-dependent patterns
    structured_markdown = """# Introduction
First paragraph should be an introduction.

## Section 1
This is early content.

## Section 2
This is middle content.

## Section 3
This is late content.

# Conclusion
Last paragraph should be a conclusion.
"""
    
    # Train a model with positional encoding
    chain = MarkChain(use_positional_encoding=True, encoding_dim=4)
    chain.train(structured_markdown)
    
    # Verify positional transitions were recorded
    assert len(chain.positional_transitions) > 0
    
    # Test that we can use it to generate content
    np.random.seed(42)
    sample = chain.sample(length=20, positional_weight=0.5)
    assert isinstance(sample, str)
    assert len(sample) > 0
    
    # Test with different positional weights
    np.random.seed(42)
    sample_no_pos = chain.sample(length=20, positional_weight=0.0)
    
    np.random.seed(42)
    sample_high_pos = chain.sample(length=20, positional_weight=0.8)
    
    # Samples should differ with different positional weighting
    assert sample_no_pos != sample_high_pos

def test_markchain_combined_features():
    """Test MarkChain with skip-grams, decay functions, and positional encoding combined."""
    # Create a document with both sequence patterns and positional patterns
    complex_markdown = """# Start Document
Introduction paragraph.

## First Section
- Early list item 1
- Early list item 2

Middle paragraph 1.

## Middle Section
- Middle list item 1
- Middle list item 2

Middle paragraph 2.

## Final Section
- Late list item 1
- Late list item 2

Conclusion paragraph.
"""

    # Create model with all features enabled
    chain = MarkChain(
        order=2,
        use_skipgrams=True,
        skip_window=3,
        decay_function=exponential_decay,
        use_positional_encoding=True,
        encoding_dim=4
    )
    
    # Train the model
    chain.train(complex_markdown)
    
    # Verify all data structures were populated
    assert len(chain.transitions) > 0
    assert len(chain.skipgram_transitions) > 0
    assert len(chain.positional_transitions) > 0
    
    # Generate with different feature combinations
    np.random.seed(42)
    sample_all = chain.sample(length=30, skipgram_weight=0.3, positional_weight=0.3)
    
    np.random.seed(42)
    sample_skip_only = chain.sample(length=30, skipgram_weight=0.6, positional_weight=0.0)
    
    np.random.seed(42)
    sample_pos_only = chain.sample(length=30, skipgram_weight=0.0, positional_weight=0.6)
    
    # All samples should be different due to different feature weightings
    assert sample_all != sample_skip_only
    assert sample_all != sample_pos_only
    assert sample_skip_only != sample_pos_only
    
    # Basic validation of output structure
    assert isinstance(sample_all, str)
    assert len(sample_all) > 0

def test_markchain_with_custom_decay():
    """Test MarkChain with custom decay functions."""
    # Define a test-specific custom decay function
    def custom_decay(distance):
        return 1.0 / (distance ** 2)
    
    # Create a chain with custom decay
    chain = MarkChain(use_skipgrams=True, skip_window=3, decay_function=custom_decay)
    chain.train(SAMPLE_MARKDOWN)
    
    # Verify decay function was set
    assert chain.decay_function is custom_decay
    
    # Test changing the decay function
    chain.set_decay_function(constant_decay)
    assert chain.decay_function is constant_decay
    
    # Generate with constant decay
    np.random.seed(42)
    constant_sample = chain.sample(length=15)
    
    # Switch to exponential decay
    chain.set_decay_function(lambda d: exponential_decay(d, base=0.1))
    
    # Generate with exponential decay
    np.random.seed(42)
    exp_sample = chain.sample(length=15)
    
    # The samples should be different due to different decay functions
    # This check might fail occasionally due to randomness, but should work most of the time
    # with the specific test data and seed 42
    assert constant_sample != exp_sample

def test_markchain_initialization():
    """Test that MarkChain initializes correctly."""
    # Test default initialization
    chain = MarkChain()
    assert chain.order == 1
    assert len(chain.transitions) == 0
    assert len(chain.start_states) == 0
    
    # Test custom order
    chain = MarkChain(order=2)
    assert chain.order == 2
    
    # Test custom state parser
    def custom_parser(text):
        return text.split()
    
    chain = MarkChain(state_parser=custom_parser)
    assert chain.state_parser is custom_parser
    
    # Test skip-gram parameters
    chain = MarkChain(use_skipgrams=True, skip_window=3)
    assert chain.use_skipgrams is True
    assert chain.skip_window == 3
    assert isinstance(chain.skipgram_transitions, defaultdict)

def test_markchain_training():
    """Test that MarkChain learns transition probabilities."""
    chain = MarkChain()
    chain.train(SAMPLE_MARKDOWN)
    
    # Should have learned some transitions
    assert len(chain.transitions) > 0
    assert len(chain.start_states) > 0
    
    # Check if key markdown elements were identified as states
    states = []
    for key in chain.transitions:
        states.extend(key)
    states.extend([target for targets in chain.transitions.values() for target in targets])
    
    # Look for specific types of markdown elements in learned states
    state_text = ' '.join(states)
    assert '#' in state_text  # Headers
    assert '-' in state_text  # Lists
    assert 'python' in state_text or '```' in state_text  # Code blocks

def test_markchain_training_higher_order():
    """Test that MarkChain can learn higher-order transitions."""
    # Test with order 2
    chain = MarkChain(order=2)
    chain.train(SAMPLE_MARKDOWN)
    
    # Should have learned some transitions
    assert len(chain.transitions) > 0
    
    # Check if transitions are tuples of length 2 (order 2)
    for history in chain.transitions:
        assert isinstance(history, tuple)
        assert len(history) == 2

    # Test with order 3
    chain = MarkChain(order=3)
    chain.train(SAMPLE_MARKDOWN)
    
    # Check if transitions are tuples of length 3 (order 3)
    for history in chain.transitions:
        assert isinstance(history, tuple)
        assert len(history) == 3

def test_markchain_training_multiple_documents():
    """Test that MarkChain can be trained on multiple documents incrementally."""
    chain = MarkChain()
    
    # Train on first document
    chain.train(SAMPLE_MARKDOWN)
    num_transitions_first = len(chain.transitions)
    
    # Train on second document
    second_markdown = """# Another Document
    
This is a different paragraph.

## Different Section

* Different list item
* Another different item
"""
    chain.train(second_markdown)
    
    # Should have more transitions after training on multiple documents
    assert len(chain.transitions) >= num_transitions_first

def test_markchain_sampling():
    """Test that MarkChain can generate new markdown."""
    chain = MarkChain()
    chain.train(SAMPLE_MARKDOWN)
    
    # Sample with default length
    generated = chain.sample()
    assert isinstance(generated, str)
    assert len(generated) > 0
    
    # Sample with custom length
    generated = chain.sample(length=5)
    assert isinstance(generated, str)
    
    # Should raise an error if not trained
    untrained_chain = MarkChain()
    with pytest.raises(ValueError):
        untrained_chain.sample()

def test_markchain_sampling_with_seed():
    """Test that MarkChain can generate markdown from a seed text."""
    chain = MarkChain()
    chain.train(SAMPLE_MARKDOWN)
    
    # Sample with seed text
    seed = "# New Document"
    generated = chain.sample(seed_text=seed)
    assert isinstance(generated, str)
    assert generated.startswith(seed)
    
    # Seed text that's too short for order should raise error
    chain = MarkChain(order=3)
    chain.train(SAMPLE_MARKDOWN)
    with pytest.raises(ValueError):
        chain.sample(seed_text="Too short")

def test_markchain_skipgram_training():
    """Test that MarkChain learns skip-gram transitions."""
    # Initialize with skip-grams enabled
    chain = MarkChain(use_skipgrams=True, skip_window=3)
    chain.train(SAMPLE_MARKDOWN)
    
    # Should have learned both regular and skipgram transitions
    assert len(chain.transitions) > 0
    assert len(chain.skipgram_transitions) > 0
    
    # Check if skipgram transitions have the right structure
    for history, skip_dict in chain.skipgram_transitions.items():
        # History should be a tuple of the right length
        assert isinstance(history, tuple)
        assert len(history) == chain.order
        
        # Skip dictionary should have keys for skip distances
        for skip_dist, counter in skip_dict.items():
            assert isinstance(skip_dist, int)
            assert 2 <= skip_dist <= chain.skip_window
            
            # Counter should have counts for target states
            assert isinstance(counter, Counter)
            assert len(counter) > 0

def test_markchain_skipgram_sampling():
    """Test that MarkChain can generate markdown using skip-gram information."""
    # Create a sequence with clear pattern
    structured_markdown = """# Header 1
Paragraph 1
- List item 1
Paragraph 2
- List item 2
Paragraph 3
- List item 3
Paragraph 4
- List item 4
"""
    
    # Train two models, one with skipgrams and one without
    chain_regular = MarkChain()
    chain_regular.train(structured_markdown)
    
    chain_skipgram = MarkChain(use_skipgrams=True, skip_window=2)
    chain_skipgram.train(structured_markdown)
    
    # Use a fixed seed to ensure comparable samples
    np.random.seed(42)
    
    # Sample from both models with the same seed
    seed_text = "# Header 1\nParagraph 1"
    sample_regular = chain_regular.sample(seed_text=seed_text, length=15)
    
    np.random.seed(42)
    sample_skipgram = chain_skipgram.sample(seed_text=seed_text, length=15)
    
    # Samples should be strings
    assert isinstance(sample_regular, str)
    assert isinstance(sample_skipgram, str)
    
    # Samples should be different due to skip-gram influence
    # (This assumption may not hold for all random seeds, but works with seed 42)
    assert sample_regular != sample_skipgram
    
    # Verify that skip-gram sample has some evidence of better pattern capture
    # by checking for alternating paragraph/list which is the pattern in the training data
    paragraphs_followed_by_lists = sum(1 for i in range(len(sample_skipgram.split('\n'))-1) 
                                if not sample_skipgram.split('\n')[i].startswith('-') and 
                                sample_skipgram.split('\n')[i+1].startswith('-'))
    
    # Log samples for manual verification
    print("\nRegular sample:\n", sample_regular)
    print("\nSkip-gram sample:\n", sample_skipgram)
    print(f"\nParagraphs followed by lists in skip-gram sample: {paragraphs_followed_by_lists}")

def test_markchain_skipgram_weight():
    """Test that skipgram_weight parameter affects generation."""
    structured_markdown = """# Header 1
Paragraph 1
- List item 1
Paragraph 2
- List item 2
Paragraph 3
- List item 3
Paragraph 4
- List item 4
"""
    
    chain = MarkChain(use_skipgrams=True, skip_window=2)
    chain.train(structured_markdown)
    
    # Fix random seed for reproducibility
    np.random.seed(42)
    
    # Generate samples with different skipgram weights
    seed_text = "# Header 1\nParagraph 1"
    sample_low_weight = chain.sample(seed_text=seed_text, length=15, skipgram_weight=0.1)
    
    np.random.seed(42)
    sample_high_weight = chain.sample(seed_text=seed_text, length=15, skipgram_weight=0.7)
    
    # Samples should be strings
    assert isinstance(sample_low_weight, str)
    assert isinstance(sample_high_weight, str)
    
    # Samples should be different due to different weights
    assert sample_low_weight != sample_high_weight
    
    # Log samples for manual verification
    print("\nLow skip-gram weight (0.1):\n", sample_low_weight)
    print("\nHigh skip-gram weight (0.7):\n", sample_high_weight)

def test_markchain_from_corpus(tmp_path):
    """Test creating a MarkChain from a corpus of files."""
    # Create test files
    corpus_dir = tmp_path / "corpus"
    corpus_dir.mkdir()
    
    file1 = corpus_dir / "test1.md"
    file1.write_text(SAMPLE_MARKDOWN)
    
    file2 = corpus_dir / "test2.md"
    file2.write_text("""# Another Document
    
This is different content.

## Section A

* Bullet 1
* Bullet 2

""")
    
    # Test with directory
    chain = MarkChain.from_corpus(str(corpus_dir))
    assert len(chain.transitions) > 0
    
    # Test with single file
    chain = MarkChain.from_corpus(str(file1))
    assert len(chain.transitions) > 0
    
    # Test with additional constructor parameters
    chain = MarkChain.from_corpus(str(corpus_dir), order=3)
    assert chain.order == 3
    
    # Test with skip-grams enabled
    chain = MarkChain.from_corpus(str(corpus_dir), use_skipgrams=True, skip_window=3)
    assert chain.use_skipgrams is True
    assert chain.skip_window == 3
    assert len(chain.skipgram_transitions) > 0

def test_custom_state_parser():
    """Test MarkChain with a custom state parser."""
    def simple_parser(markdown_text):
        """Very simple parser that just returns lines."""
        for line in markdown_text.split('\n'):
            if line.strip():
                yield line.strip()
    
    chain = MarkChain(state_parser=simple_parser)
    chain.train(SAMPLE_MARKDOWN)
    
    # Should have learned transitions between lines
    assert len(chain.transitions) > 0
    
    # Sample should work
    generated = chain.sample(length=5)
    assert isinstance(generated, str)
    assert len(generated) > 0

def test_default_state_parser():
    """Test the default state parser's ability to identify markdown elements."""
    chain = MarkChain()
    states = list(chain._default_state_parser(SAMPLE_MARKDOWN))
    
    # Check that it correctly identifies headers
    headers = [s for s in states if s.startswith('#')]
    assert len(headers) >= 3  # At least 3 headers in SAMPLE_MARKDOWN
    
    # Check that it correctly identifies lists
    lists = [s for s in states if s.startswith('-') or s.startswith('*')]
    assert len(lists) >= 1  # At least one list in SAMPLE_MARKDOWN
    
    # Check that it correctly identifies code blocks
    code_blocks = [s for s in states if '```' in s]
    assert len(code_blocks) >= 1  # At least one code block in SAMPLE_MARKDOWN

def test_states_to_markdown():
    """Test converting states back to markdown text."""
    chain = MarkChain()
    
    # Parse document into states
    states = list(chain._default_state_parser(SAMPLE_MARKDOWN))
    
    # Convert back to markdown
    reconstructed = chain._states_to_markdown(states)
    
    # Should preserve basic structure
    assert "# Test Document" in reconstructed
    assert "## Section 1" in reconstructed
    assert "- List item" in reconstructed
    assert "```python" in reconstructed
    assert "def test():" in reconstructed

def test_deterministic_sampling(monkeypatch):
    """Test that sampling with fixed seed produces deterministic results."""
    # Mock random.choice and np.random.choice to be deterministic
    def mock_random_choice(seq):
        return seq[0]
    
    def mock_np_random_choice(a, p=None):
        return a[0]
    
    monkeypatch.setattr("random.choice", mock_random_choice)
    monkeypatch.setattr("numpy.random.choice", mock_np_random_choice)
    
    chain = MarkChain()
    chain.train(SAMPLE_MARKDOWN)
    
    # Should generate the same text each time
    result1 = chain.sample()
    result2 = chain.sample()
    assert result1 == result2

def test_generate_and_analyze_samples():
    """Test generating multiple samples from MarkChain and analyze them."""
    # Initialize and train the model
    chain = MarkChain()
    chain.train(SAMPLE_MARKDOWN)
    
    # Generate multiple samples with different seeds
    num_samples = 5
    samples = []
    
    # Use random seeds for different samples
    import random
    for i in range(num_samples):
        random.seed(i)
        np.random.seed(i)
        sample = chain.sample(length=50)
        samples.append(sample)
    
    # Save samples to the outputs directory for inspection
    output_dir = Path('tests/outputs')
    output_dir.mkdir(exist_ok=True)
    output_path = output_dir / 'markchain_samples.md'
    
    # Generate a markdown report with the samples and analysis
    with open(output_path, 'w') as f:
        f.write("# MarkChain Sample Generation Analysis\n\n")
        f.write("This file shows multiple samples generated by MarkChain from the same training data.\n\n")
        
        # Write the training data for reference
        f.write("## Training Data\n\n")
        f.write("```markdown\n")
        f.write(SAMPLE_MARKDOWN)
        f.write("\n```\n\n")
        
        # Write the samples and analysis
        f.write("## Generated Samples\n\n")
        
        for i, sample in enumerate(samples):
            f.write(f"### Sample {i+1} (seed={i})\n\n")
            f.write("```markdown\n")
            f.write(sample)
            f.write("\n```\n\n")
            
            # Basic analysis of the sample
            f.write("**Analysis**:\n\n")
            
            # Count states by type
            states = list(default_state_parser(sample))
            state_types = {}
            for state in states:
                state_type = "header" if state.startswith('#') else \
                            "list" if state.startswith('-') or state.startswith('*') else \
                            "code" if '```' in state else "paragraph"
                state_types[state_type] = state_types.get(state_type, 0) + 1
            
            f.write("State distribution:\n\n")
            for state_type, count in state_types.items():
                f.write(f"- {state_type}: {count}\n")
            
            # Identify if the sample has hierarchy
            headers = [s for s in states if s.startswith('#')]
            header_levels = [s.count('#') for s in headers]
            has_hierarchy = len(set(header_levels)) > 1
            
            f.write(f"\nHas heading hierarchy: {has_hierarchy}\n")
            
            # Check for lists and code blocks
            has_lists = any(s.startswith('-') or s.startswith('*') for s in states)
            has_code = any('```' in s for s in states)
            
            f.write(f"Contains lists: {has_lists}\n")
            f.write(f"Contains code blocks: {has_code}\n\n")
            
            # Calculate transition variety (how many different state transitions)
            transitions = []
            for j in range(len(states) - 1):
                transitions.append((states[j], states[j+1]))
            
            unique_transitions = len(set(transitions))
            total_transitions = len(transitions)
            
            f.write(f"Unique state transitions: {unique_transitions} out of {total_transitions} total\n\n")
            f.write("---\n\n")
        
        # Comparative analysis
        f.write("## Comparative Analysis\n\n")
        f.write("This section compares the variety across all generated samples.\n\n")
        
        # Calculate diversity of starting states
        starting_states = [list(default_state_parser(sample))[0] for sample in samples if list(default_state_parser(sample))]
        unique_starts = len(set(starting_states))
        
        f.write(f"Number of unique starting states: {unique_starts} out of {len(samples)}\n\n")
        
        # Calculate total unique states across all samples
        all_states = []
        for sample in samples:
            all_states.extend(list(default_state_parser(sample)))
        
        unique_states = len(set(all_states))
        
        f.write(f"Total unique states across all samples: {unique_states}\n")
        f.write(f"Total states generated: {len(all_states)}\n")
    
    # Test assertions
    assert len(samples) == num_samples
    assert all(isinstance(sample, str) for sample in samples)
    assert all(len(sample) > 0 for sample in samples)

if __name__ == "__main__":
    pytest.main(["-xvs", __file__]) 